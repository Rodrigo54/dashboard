{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "./src",
    "types": []
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/renderer/app/shared/spartan/**/src/**/*.ts"
  ],
  "exclude": ["src/renderer/**/*.spec.ts"]
}
