{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@/*": ["./src/renderer/app/*"],
      "@/shared/spartan/badge": ["./src/renderer/app/shared/spartan/badge/src/index.ts"],
      "@/shared/spartan/utils": ["./src/renderer/app/shared/spartan/utils/src/index.ts"],
      "@/shared/spartan/separator": ["./src/renderer/app/shared/spartan/separator/src/index.ts"],
      "@/shared/spartan/spinner": ["./src/renderer/app/shared/spartan/spinner/src/index.ts"],
      "@/shared/spartan/empty": ["./src/renderer/app/shared/spartan/empty/src/index.ts"],
      "@/shared/spartan/breadcrumb": ["./src/renderer/app/shared/spartan/breadcrumb/src/index.ts"],
      "@/shared/spartan/avatar": ["./src/renderer/app/shared/spartan/avatar/src/index.ts"],
      "@/shared/spartan/button": ["./src/renderer/app/shared/spartan/button/src/index.ts"],
      "@/shared/spartan/table": ["./src/renderer/app/shared/spartan/table/src/index.ts"],
      "@/shared/spartan/input": ["./src/renderer/app/shared/spartan/input/src/index.ts"],
      "@/shared/spartan/input-group": [
        "./src/renderer/app/shared/spartan/input-group/src/index.ts"
      ],
      "@/shared/spartan/textarea": ["./src/renderer/app/shared/spartan/textarea/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "strictOutputEventTypes": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
